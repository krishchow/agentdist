{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "engine": {
      "type": "string",
      "const": "v1"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "skills": {
      "type": "string"
    },
    "agents": {
      "type": "string"
    },
    "commands": {
      "type": "string"
    },
    "mcpServers": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "transport": {
            "default": "stdio",
            "type": "string",
            "const": "stdio"
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "envPassthrough": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "startupTimeoutSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "toolTimeoutSec": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    "namespace": {
      "default": "prefix",
      "type": "string",
      "enum": [
        "prefix",
        "none"
      ]
    },
    "onboardingSkill": {
      "type": "string"
    },
    "scopes": {
      "default": [
        "local",
        "user"
      ],
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "local",
          "user"
        ]
      }
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listing": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string"
        },
        "shortDescription": {
          "type": "string"
        },
        "longDescription": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "keywords": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "defaultPrompts": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "brandColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "homepage": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "pack": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "engine",
    "name"
  ],
  "additionalProperties": false,
  "title": "agentpkg.json"
}
