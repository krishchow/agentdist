{
  "name": "agentdist",
  "version": "0.1.0",
  "description": "Install engine for agent packages: write skills, subagents, commands, hooks and MCP servers once, install them into any AI coding harness at repository or user scope.",
  "keywords": [
    "agent-skills",
    "mcp",
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "gemini-cli",
    "opencode",
    "installer",
    "skills",
    "hooks",
    "subagents",
    "ai-agents"
  ],
  "author": "Krish Chowdhary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krishchow/agentdist.git"
  },
  "homepage": "https://github.com/krishchow/agentdist#readme",
  "bugs": "https://github.com/krishchow/agentdist/issues",
  "type": "module",
  "bin": {
    "agentdist": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema/agentdist.schema.json"
  },
  "files": [
    "dist",
    "schema",
    "docs",
    "!docs/research",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node scripts/gen-schema.mjs && node scripts/gen-harness-table.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "bash e2e/run.sh",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm test",
    "prepublishOnly": "pnpm run check"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
